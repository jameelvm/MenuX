# Copy to .env for local development. Placeholder values only; never put real credentials here.
POSTGRES_DB=menux
POSTGRES_USER=menux
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
# Application roles (doc 09 §4.2), created on first start. Local placeholders only.
MENUX_OWNER_PASSWORD=local-owner-change-me
MENUX_APP_PASSWORD=local-app-change-me
MENUX_PLATFORM_PASSWORD=local-platform-change-me

DYNAMODB_PORT=8000

LOCALSTACK_PORT=4566
# Region used by the local emulators only. It is not the ADR-17 region decision.
AWS_REGION=us-east-1

# Local Keycloak (admin console at http://localhost:8080). Test users: see infrastructure/local/keycloak.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-change-me

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
