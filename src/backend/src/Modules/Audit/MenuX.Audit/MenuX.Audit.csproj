    <ProjectReference Include="..\MenuX.Audit.Contracts\MenuX.Audit.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\MenuX.Identity.Contracts\MenuX.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\MenuX.SharedKernel\MenuX.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\MenuX.Infrastructure\MenuX.Infrastructure.csproj" />
  </ItemGroup>
</Project>
